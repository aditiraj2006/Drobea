# Root .gitignore

# Environment variables
.env
.env.local
.env.*.local

# OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Firebase credentials
firebase-credentials.json
*-firebase-adminsdk-*.json

# Database dumps
*.sql
*.sqlite
*.db

# Backup files
*.bak
*.backup

# Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z
